    { "id": "why-india", "type": "mcq", "prompt": "Why did Natal planters bring workers from India?", "options": ["Zulu men refused to work on plantations for low wages", "Indians were experts at mining", "India had no sugar industry", "Britain banned local labour"], "answer": 0 },
    { "id": "indenture", "type": "open", "marks": 2, "prompt": "Explain what indentured labour means.", "memo": "✓ A worker signs a contract to work for a particular employer (1)\n✓ for a fixed number of years (usually five) in return for passage, food, housing and wages (1)" },
    { "id": "gandhi-year", "type": "short", "prompt": "What was the name of Gandhi's method of non-violent resistance?", "answers": ["satyagraha", "passive resistance"] },
