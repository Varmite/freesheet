# Copy this file to server/.env and fill it in. Never commit server/.env: it holds a secret.

# Where the site is reached from the internet, with no slash at the end (must be https for Google).
PUBLIC_URL=https://your-laptop.your-tailnet.ts.net
# From Google Cloud Console > APIs & Services > Credentials (see server/README.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

PORT=8080
# 1 when a tunnel or reverse proxy sits in front. Leave it out if the server faces the internet directly.
TRUST_PROXY=1
# Stop accepting new learners once saved progress reaches this size.
MAX_DATA_MB=2048
