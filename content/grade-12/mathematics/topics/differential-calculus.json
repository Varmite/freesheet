    {
      "type": "example",
      "title": "Worked example 5",
      "problem": "A farmer has 200 m of fencing to make a rectangular enclosure against a straight wall (the wall forms one side). Find the maximum area.",
      "steps": [
        "Let the sides perpendicular to the wall be $x$; the side parallel is $200 - 2x$.",
        "$A = x(200 - 2x) = 200x - 2x^2$",
        "$A'(x) = 200 - 4x = 0 \\Rightarrow x = 50$",
        "$A = 50 \\times 100 = 5\\ 000$ m² (a maximum, since $A''(x) = -4 < 0$)"
      ],
      "answer": "5 000 m²"
    },
    {
      "type": "callout",
      "label": "Rates of change",
      "text": "If $s(t)$ is displacement, then $s'(t)$ is velocity and $s''(t)$ is acceleration."
    }
