# FreeSheet web edition settings. install.sh copies this to .env and fills it in.
# Lines starting with # are comments. Restart after changing: sudo systemctl restart freesheet-web

# From Google Cloud Console > Google Auth Platform > Clients (a "Web application" client).
# Looks like 1234567890-abc123.apps.googleusercontent.com. See SETUP.md step 1.
GOOGLE_CLIENT_ID=

# Who may sign in, separated by commas. Empty = any Google account.
ALLOWED_EMAILS=

# The port to listen on (your router forwards it to this laptop).
PORT=5000

# Where progress and sign-ins are kept. Back this folder up. Relative to web/.
DATA_DIR=data

# HTTPS certificate and key (full paths). With both set, the server speaks https on PORT.
# setup-https.sh fills these in (SETUP.md step 3). Empty = plain http (only for testing at home).
HTTPS_CERT=
HTTPS_KEY=

# Signs sessions. Made automatically on first run if empty; changing it signs everyone out.
SESSION_SECRET=

# Install updates from GitHub automatically, but only when nobody has used FreeSheet for
# UPDATE_IDLE_MINUTES. Set AUTO_UPDATE=0 to update by hand with update.sh.
AUTO_UPDATE=1
UPDATE_CHECK_MINUTES=60
UPDATE_IDLE_MINUTES=15

# Only if you put FreeSheet behind an https proxy such as Cloudflare Tunnel (SETUP.md):
# COOKIE_SECURE=1
# TRUST_PROXY=1
