# The Android release signing key: never commit it. Keep a backup somewhere safe; without
# it, future versions cannot be installed over the current one.
src-tauri/android/keystore/
# Old location (Android Edition 1.0), kept locally as a backup. Signing keys anywhere:
Android Edition/
*.jks
*.keystore
keystore.properties

